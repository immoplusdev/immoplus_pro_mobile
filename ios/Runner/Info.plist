<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Immoplus Pro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>immoplus_pro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>yourdomain.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSThirdPartyExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>ImmoPLus Pro utilise l’appareil photo pour vous permettre de prendre des photos.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>ImmoPLus Pro nécessite un accès à votre position même lorsque l’application est en arrière-plan.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>ImmoPLus Pro nécessite un accès permanent à votre position, même lorsque l’application est fermée.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ImmoPLus Pro a besoin d’accéder à votre position pour afficher votre emplacement sur la carte et fournir des services basés sur votre localisation.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Cette app a besoin d’accéder au micro pour enregistrer l’audio (mémos vocaux, appels, etc.).</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>ImmoPLus Pro enregistre des photos dans votre photothèque.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ImmoPLus Pro a besoin d’accéder à votre photothèque pour sélectionner des images.</string>
	<key>NSUserNotificationUsageDescription</key>
	<string>ImmoPLus Pro souhaite vous envoyer des notifications.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
